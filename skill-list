#!/usr/bin/env bash
# skill-list — list the skills in this marketplace, grouped by plugin
#
# Usage:
#   skill-list              each plugin, then its skills with their descriptions
#   skill-list --names      plain name list (one per line, for scripting)

set -euo pipefail

MARKET_DIR="$(cd "$(dirname "$0")" && pwd)"

if [[ "${1:-}" == "--names" ]]; then
  for skill in "$MARKET_DIR"/plugins/*/skills/*/SKILL.md; do
    basename "$(dirname "$skill")"
  done | sort
  exit 0
fi

for plugin in "$MARKET_DIR"/plugins/*/; do
  echo "## $(basename "$plugin")"
  for skill in "$plugin"skills/*/SKILL.md; do
    name=$(basename "$(dirname "$skill")")
    desc=$(sed -n 's/^description: *//p' "$skill" | head -1 | sed 's/^"//; s/"$//')
    printf '  %-45s %s\n' "$name" "${desc:0:110}"
  done
  echo
done
